# CareerLens AI Environment Configuration Example
# Copy this file to .env and insert your real credentials. Never commit .env to Git.

# Gemini API Key (obtain from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Preferred model identifier (defaults to gemini-3-flash-preview)
GEMINI_MODEL=gemini-3-flash-preview

# Optional: Host and Port for backend server
HOST=127.0.0.1
PORT=8000
